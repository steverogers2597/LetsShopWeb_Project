<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ════════════════════════════════════════════════
         📦 SECTION 1 — PROJECT IDENTITY
         Defines who this project is
    ════════════════════════════════════════════════ -->
    <groupId>org.example</groupId>
    <artifactId>LetsShopWeb_Project</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>


    <!-- ════════════════════════════════════════════════
         ⚙️ SECTION 2 — GLOBAL PROPERTIES
         Central place to manage versions & encoding.
         Change a version here — it updates everywhere.
    ════════════════════════════════════════════════ -->
    <properties>

        <!-- Encoding -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java Version -->
        <maven.compiler.release>21</maven.compiler.release>

        <!-- Dependency Versions -->
        <selenium.version>4.44.0</selenium.version>
        <testng.version>7.12.0</testng.version>
        <cucumber.version>7.34.3</cucumber.version>
        <extentreports.version>5.1.1</extentreports.version>

    </properties>


    <!-- ════════════════════════════════════════════════
         📚 SECTION 3 — DEPENDENCIES
         External libraries your project needs to run.
         Grouped by purpose for clarity.
    ════════════════════════════════════════════════ -->
    <dependencies>

        <!-- ─────────────────────────────────────────
             🌐 GROUP A — Browser Automation
             Drives and controls the browser
        ───────────────────────────────────────── -->

        <!-- Selenium Java: Core library that controls browsers -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>


        <!-- ─────────────────────────────────────────
             🧪 GROUP B — Test Framework
             Manages test execution and assertions
        ───────────────────────────────────────── -->

        <!-- TestNG: Runs, organises and reports tests -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>


        <!-- ─────────────────────────────────────────
             🥒 GROUP C — Cucumber BDD Framework
             Enables Gherkin-based test scenarios
        ───────────────────────────────────────── -->

        <!-- Cucumber Java: Enables @Given @When @Then step annotations -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>

        <!-- Cucumber TestNG: Bridges Cucumber with TestNG runner -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
        </dependency>


        <!-- ─────────────────────────────────────────
             📊 GROUP D — Reporting
             Generates rich visual HTML test reports
        ───────────────────────────────────────── -->

        <!-- ExtentReports: Creates detailed HTML reports with logs & screenshots -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

    </dependencies>


    <!-- ════════════════════════════════════════════════
         🔨 SECTION 4 — BUILD PLUGINS
         Controls how Maven compiles and runs your tests
    ════════════════════════════════════════════════ -->
    <build>
        <plugins>

            <!-- ─────────────────────────────────────────
                 🔧 PLUGIN 1 — Maven Compiler Plugin
                 Compiles your Java source code to Java 21
            ───────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <!-- Reads maven.compiler.release=21 from properties above -->
            </plugin>

            <!-- ─────────────────────────────────────────
                 🧪 PLUGIN 2 — Maven Surefire Plugin
                 Executes your tests via testng.xml when
                 you run: mvn test
            ───────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>testng.xml</suiteXmlFile>
                    </suiteXmlFiles>
                    <testFailureIgnore>false</testFailureIgnore>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
